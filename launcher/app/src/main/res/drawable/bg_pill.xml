<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E624324E"
                android:endColor="#E6122138" />
            <stroke android:width="2.5dp" android:color="#E8C686" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9293D5A" />
            <stroke android:width="2dp" android:color="#38BDF8" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#B33B2C59"
                android:endColor="#B31B2642" />
            <stroke android:width="1.5dp" android:color="#E8C686" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#B3162033"
                android:endColor="#B30D1422" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
