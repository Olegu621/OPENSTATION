<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFF1B8"
                android:centerColor="#EBC67B"
                android:endColor="#C89B4B" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EBC67B" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#EED091"
                android:endColor="#C69747" />
            <stroke android:width="1dp" android:color="#77FFF5D6" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
