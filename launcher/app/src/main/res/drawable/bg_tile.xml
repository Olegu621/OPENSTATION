<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E622324F"
                android:endColor="#E6101B30" />
            <stroke android:width="2.5dp" android:color="#E8C686" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC1A3550" />
            <stroke android:width="2.5dp" android:color="#38BDF8" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#CC2B2446"
                android:endColor="#CC141A2C" />
            <stroke android:width="1.5dp" android:color="#D4AF6A" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#B3141E30"
                android:endColor="#B30C121E" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
