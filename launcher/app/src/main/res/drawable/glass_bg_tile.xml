<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#34FFFFFF"
                android:endColor="#1FFFFFFF" />
            <stroke android:width="1.2dp" android:color="#B8FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#48FFFFFF" />
            <stroke android:width="1.2dp" android:color="#E6FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#28FFFFFF"
                android:endColor="#18FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#16FFFFFF"
                android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
